║                      SUBDOMAIN ENUMERATOR                                ║
║                    Find subdomains of a target domain                    ║
╚══════════════════════════════════════════════════════════════════════════╝

USAGE:
    python3 subdomain_enum.py [OPTIONS] [TARGET] [WORDLIST]

OPTIONS:
    -h, --help     Show this help message
    -v, --version  Show version information

TARGET:
    The domain to enumerate (e.g., example.com)

WORDLIST:
    Optional: Custom wordlist file (default: subdomains.txt)

EXAMPLES:
    python3 subdomain_enum.py example.com
    python3 subdomain_enum.py example.com my_wordlist.txt

VERSION:
    1.0
    """)

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ["-h", "--help"]:
        print_help()
        return
    if len(sys.argv) > 1 and sys.argv[1] in ["v", "--version"]:
        print("Subdomain Enumerator v1.0")
        return

    if len(sys.argv) > 1:
        target = sys.argv[1]
    else: 
        target = input("Enter target domain (e.g., example.com)")

    if len(sys.argv) > 2:
        wordlist_file = sys.argv[2]
    else:
        wordlist_file = "subdomains.txt"

    wordlist = load_wordlist(wordlist_file)
    if not wordlist:
        print("No subdomains to check. Exiting.")
        return

    print(f"\nEnumerating subdomain for {target}...")
    print(f"Using {len(wordlist)} subdomain names..\n")

    enumerate_subdomains(target, wordlist)

    print(f"\nFound {len(found)} subdomains")

    if found:
        save_results(target)

if __name__ == "__main__":
    main()